background = Image("background.png");

Window.SetBackgroundBottomColor(0, 0, 0);
Window.SetBackgroundTopColor(0, 0, 0);

bg_sprite = Sprite(background);
bg_sprite.SetZ(-100);

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();
bg_width = background.GetWidth();
bg_height = background.GetHeight();

bg_sprite.SetX((screen_width - bg_width) / 2);
bg_sprite.SetY((screen_height - bg_height) / 2);

throbber = Sprite();
throbber.SetX(screen_width / 2);
throbber.SetY(screen_height * 0.85);
throbber.SetOpacity(0.8);

n_frames = 24;
current_frame = 0;

for (f = 0; f < n_frames; f++) {
    frame_name = "throbber-" + f + ".png";
    if (f < 10) {
        frame_name = "throbber-00" + f + ".png";
    } else if (f < 100) {
        frame_name = "throbber-0" + f + ".png";
    }
    frames[f] = Image(frame_name);
}

throbber.SetImage(frames[current_frame]);

message_sprite = Sprite();
message_sprite.SetX(screen_width / 2);
message_sprite.SetY(screen_height * 0.92);

fun refresh_callback() {
    current_frame = (current_frame + 1) % n_frames;
    throbber.SetImage(frames[current_frame]);
}

Plymouth.SetRefreshFunction(refresh_callback);

fun boot_progress_callback(duration, progress) {
}

Plymouth.SetBootProgressFunction(boot_progress_callback);

fun display_normal_callback() {
    message_sprite.SetImage(Image());
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);

fun display_password_callback(prompt, bullets) {
    msg = "";
    for (b = 0; b < bullets; b++) {
        msg = msg + "*";
    }
    message_sprite.SetImage(Image.Text(prompt + " " + msg, 1, 1, 1, 1, "Cantarell", 1));
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun hide_message_callback() {
    message_sprite.SetImage(Image());
}

Plymouth.SetHideMessageFunction(hide_message_callback);

fun display_message_callback(message) {
    message_sprite.SetImage(Image.Text(message, 1, 1, 1, 0.8, "Cantarell", 1));
}

Plymouth.SetDisplayMessageFunction(display_message_callback);

fun on_quit() {
}

Plymouth.SetQuitFunction(on_quit);
