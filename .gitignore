# Python build/run artifacts (the hyprtk-usb GUI installer pip-builds in place)
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/

# Generated artifacts / internal docs — never published
output.html
PLANNING.md
install.log
installer/scripts/verify/
.scratch/
configs/root/.cache/
configs/root/.config/sublime-text/

# Generated by the bar installer and hyprtk-usb's GUI installer (they write into
# this dir because ~/.local/bin is symlinked here) — keep the vendored binaries
# tracked (gum, hyprtk-usb, ...).
installer/standalone/hyprtk-bar
installer/standalone/hyprtk-bar-*-toggle.sh
installer/standalone/wal
installer/standalone/hyprtk-usb-gui
installer/standalone/hyprtk-usb-helper

# Generated by the installer: a per-user symlink to the pywal-rendered btop
# theme (the repo must not hardcode a home path here).
configs/btop/themes/btopwal.theme
