#!/usr/bin/env bash
# Toggle the hyprtk-bar-qt themer panel via Quickshell IPC (bind to a hotkey).
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
done
here="$(cd -P "$(dirname "$src")" && pwd)"
root="$(cd "$here/.." && pwd)"
# Prefer the *running* instance's root: the bar may be run from a dev
# checkout rather than this install dir, and `qs ipc -p` matches by path.
running="$(pgrep -a qs 2>/dev/null | sed -n 's/.* -p \([^ ]*hyprtk-bar-qt[^ ]*\).*/\1/p' | head -1)"
[ -n "$running" ] && root="$running"

exec qs -p "$root" ipc call themer toggle
