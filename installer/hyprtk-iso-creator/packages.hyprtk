# hyprtk desktop packages baked into the live ISO.
# Official Arch repos only (groups such as `xfce4` are allowed).
# AUR-only extras live in aur-packages.txt and are built separately.
# The builder verifies every name against the sync databases and drops
# anything it cannot resolve, so a stale entry here cannot break the build.

## Shell / basics
zsh
git
gum
fzf
curl
wget
jq
bc
nano
neovim
vim
micro
ranger
starship
fastfetch
btop
eza
desktop-file-utils
xdg-utils
xdg-user-dirs
xdg-user-dirs-gtk
unzip
7zip
unrar

## Display server / compositor / greeter
hyprland
xdg-desktop-portal-hyprland
xdg-desktop-portal-wlr
xdg-desktop-portal-gtk
sddm
weston
hyprpicker
hyprsunset
hyprlock
hypridle
# fallback locker/idle daemon; hyprlock/hypridle (above) are the default and
# the dotfiles' lock.sh/autostart prefer them.
swayidle
# swaylock comes from the AUR swaylock-effects package (see aur-packages.txt);
# installing the repo swaylock too would conflict on /usr/bin/swaylock.
swappy
cliphist
wl-clipboard
grim
slurp
wf-recorder
wob
awww

