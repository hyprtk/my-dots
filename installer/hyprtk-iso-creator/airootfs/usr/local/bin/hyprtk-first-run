#!/bin/bash
# hyprtk-first-run — one-time per-user setup.
#
# Runs from the systemd user unit installed in /etc/skel/.config/systemd/user,
# so every account created on the live ISO (or from the ISO's skel) gets a
# working bar + pywal palette on first login. Idempotent: writes a stamp and
# exits immediately on later runs.
set -u

REPO="${HYPRTK_REPO:-$HOME/hyprtk}"
STAMP="$HOME/.local/share/hyprtk/.first-run-done"

[ -e "$STAMP" ] && exit 0
[ -d "$REPO" ] || { echo "hyprtk-first-run: no hyprtk repo at $REPO" >&2; exit 0; }

export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"

# 1. hyprtk-bar (bundled pywal16 comes with it). System deps are already on the
#    ISO, so --no-deps is correct here.
#    Gate on the installed venv, not on the ~/.local/bin launcher: ~/.local/bin
#    is a symlink into the vendored repo, so a stale launcher (e.g. one left on
#    the build host) can exist and be executable while the venv behind it is
#    gone. Checking the launcher made first-run skip the install entirely.
BAR_VENV="$HOME/.local/share/hyprtk-bar/venv"
if [ ! -x "$BAR_VENV/bin/python3" ]; then
    # Clear any stale launchers so the reinstall starts clean.
    rm -f "$HOME/.local/bin/hyprtk-bar" "$HOME/.local/bin/wal"
    rm -f "$HOME"/.local/bin/hyprtk-bar-*-toggle.sh
    bash "$REPO/installer/hyprtk-bar/scripts/fix-imagemagick-policy.sh" >/dev/null 2>&1 || true
    bash "$REPO/installer/hyprtk-bar/install.sh" --no-deps \
        || echo "hyprtk-first-run: hyprtk-bar install did not finish" >&2
fi

# 2. First palette from the default wallpaper.
if command -v wal >/dev/null 2>&1; then
    wal -n -i "$REPO/assets/Wallpapers/default.png" >/dev/null 2>&1 || true
fi
cp -f "$REPO/assets/Wallpapers/default.png" "$HOME/.cache/current-wallpaper.png" 2>/dev/null || true

# 3. Locker fallback. hyprlock is the default (installed from the official repo)
#    and reads its colours from the pywal fragment rendered above. If the AUR
#    swaylock-effects did not make it onto the image, drop a plain-swaylock
#    config so the fallback lock screen still works instead of erroring on the
#    effects-only options in the shipped config.
if ! pacman -Qq swaylock-effects >/dev/null 2>&1; then
    [ -L "$HOME/.config/swaylock/config" ] && rm -f "$HOME/.config/swaylock/config"
    mkdir -p "$HOME/.config/swaylock"
    cat > "$HOME/.config/swaylock/config" <<'EOF'
ignore-empty-password
font="Cantarell"
clock
timestr=%R
datestr=%a, %e of %B
image=~/.cache/current-wallpaper.png
indicator
indicator-radius=200
indicator-thickness=20
indicator-caps-lock
inside-color=0F182544
inside-ver-color=00000000
ring-color=AD998744
ring-ver-color=FFFFFF00
separator-color=00000000
text-color=FFFFFF
text-ver-color=FFFFFF
key-hl-color=AD998744
bs-hl-color=FF0000
EOF
fi

# Stamp only once the bar is actually installed, so a failed run (no network,
# transient error) is retried on the next login instead of being skipped
# forever by the unit's ConditionPathExists=!stamp guard.
if [ -x "$BAR_VENV/bin/python3" ]; then
    mkdir -p "$(dirname "$STAMP")"
    touch "$STAMP"
else
    echo "hyprtk-first-run: bar venv still missing — will retry next login" >&2
fi
