#!/usr/bin/env python3
"""A canned ``hyprctl`` for the E2E harness.

The bar shells out to ``hyprctl`` for monitor/workspace/client state. Under the
headless sway session there is no Hyprland, so this shim answers with a small,
deterministic fake desktop. Put it first on PATH; the bar cannot tell the
difference. ``hyprctl version`` reports 0.56.0 so HyprIPC uses the Lua dispatch
grammar (the modern path we want to exercise).
"""
from __future__ import annotations

import json
import sys

MONITORS = [
    {
        "id": 0,
        "name": "HEADLESS-1",
        "description": "headless e2e monitor",
        "width": 1920,
        "height": 1080,
        "x": 0,
        "y": 0,
        "scale": 1.0,
        "focused": True,
        "activeWorkspace": {"id": 1, "name": "1"},
        "geometry": {"x": 0, "y": 0, "width": 1920, "height": 1080},
        "model": "e2e",
    }
]

WORKSPACES = [
    {"id": i, "name": str(i), "monitor": "HEADLESS-1", "windows": 0, "hasfullscreen": False}
    for i in range(1, 6)
]

CLIENTS = [
    {
        "address": "0xdeadbeef",
        "class": "Alacritty",
        "title": "e2e terminal",
        "workspace": {"id": 1, "name": "1"},
        "monitor": 0,
        "focusHistoryID": 0,
        "mapped": True,
        "hidden": False,
        "floating": False,
    }
]

LAYERS = {
    "HEADLESS-1": {
        "levels": {
            "0": [
                {
                    "namespace": "hyprtk-bar",
                    "pid": 0,
                    "x": 0,
                    "y": 0,
                    "w": 1920,
                    "h": 40,
                }
            ],
            "1": [],
            "2": [],
            "3": [],
        }
    }
}


def main(argv: list[str]) -> int:
    args = argv[1:]
    if not args:
        print("usage: fake-hyprctl [-j] <cmd> [args]", file=sys.stderr)
        return 1
    as_json = False
    if args and args[0] in ("-j", "--json"):
        as_json = True
        args = args[1:]
    if not args:
        return 1
    cmd = args[0]

    if cmd == "version":
        # No -j form; HyprIPC regexes the version out of this text.
        print("Hyprland, built from branch main at commit e2e (0.56.0)")
        print("flags: (if any)")
        return 0
    if cmd == "monitors":
        data = MONITORS
    elif cmd == "workspaces":
        data = WORKSPACES
    elif cmd == "clients":
        data = CLIENTS
    elif cmd == "activewindow":
        data = {"class": "Alacritty", "title": "e2e terminal", "address": "0xdeadbeef"}
    elif cmd == "layers":
        data = LAYERS
    elif cmd in ("cursorpos",):
        print("960, 540")
        return 0
    elif cmd == "dispatch":
        print("ok")
        return 0
    else:
        data = {}

    if as_json:
        print(json.dumps(data))
    else:
        print(json.dumps(data, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
